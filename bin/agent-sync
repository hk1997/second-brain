#!/bin/bash
# OAB Watcher Daemon Lifecycle Manager

# Resolve repository root directory
BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$BIN_DIR/.." && pwd)"

PID_FILE="$REPO_ROOT/.watcher.pid"
LOG_FILE="$REPO_ROOT/.watcher.log"
SYNC_SCRIPT="$REPO_ROOT/scripts/agent_sync.py"

check_status() {
    if [ -f "$PID_FILE" ]; then
        PID=$(cat "$PID_FILE")
        if ps -p "$PID" > /dev/null 2>&1; then
            return 0 # Running
        else
            return 1 # PID file exists but process is dead
        fi
    else
        return 2 # Not running, no PID file
    fi
}

start_daemon() {
    check_status
    STATUS=$?
    
    if [ $STATUS -eq 0 ]; then
        echo "OAB Watcher is already running (PID: $(cat "$PID_FILE"))."
        exit 0
    elif [ $STATUS -eq 1 ]; then
        echo "Found stale PID file. Cleaning it up..."
        rm -f "$PID_FILE"
    fi
    
    echo "Starting OAB Watcher in background..."
    nohup python3 "$SYNC_SCRIPT" --loop > "$LOG_FILE" 2>&1 &
    
    PID=$!
    echo "$PID" > "$PID_FILE"
    
    # Wait a second and verify it started
    sleep 1
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "OAB Watcher started successfully (PID: $PID)."
        echo "Logs are being written to: $LOG_FILE"
    else
        echo "Error: OAB Watcher failed to start. Check logs at: $LOG_FILE"
        rm -f "$PID_FILE"
        exit 1
    fi
}

stop_daemon() {
    check_status
    STATUS=$?
    
    if [ $STATUS -eq 2 ]; then
        echo "OAB Watcher is not running."
        exit 0
    fi
    
    PID=$(cat "$PID_FILE")
    echo "Stopping OAB Watcher (PID: $PID)..."
    kill "$PID"
    
    # Wait for shutdown
    for i in {1..5}; do
        if ! ps -p "$PID" > /dev/null 2>&1; then
            break
        fi
        sleep 1
    done
    
    if ps -p "$PID" > /dev/null 2>&1; then
        echo "Force killing OAB Watcher (PID: $PID)..."
        kill -9 "$PID"
    fi
    
    rm -f "$PID_FILE"
    echo "OAB Watcher stopped."
}

show_status() {
    check_status
    STATUS=$?
    
    if [ $STATUS -eq 0 ]; then
        echo "OAB Watcher Status: RUNNING (PID: $(cat "$PID_FILE"))"
    else
        echo "OAB Watcher Status: STOPPED"
    fi
}

show_logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -n 50 "$LOG_FILE"
        echo -e "\n--- Press Ctrl+C to stop tailing logs ---"
        tail -f "$LOG_FILE"
    else
        echo "No log file found at: $LOG_FILE"
    fi
}

case "$1" in
    start)
        start_daemon
        ;;
    stop)
        stop_daemon
        ;;
    status)
        show_status
        ;;
    logs)
        show_logs
        ;;
    *)
        echo "Usage: $0 {start|stop|status|logs}"
        exit 1
        ;;
esac
